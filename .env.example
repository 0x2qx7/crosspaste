# Порт сервиса на хосте
HOST_PORT=8089

# Внутренние параметры приложения
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3000

# Лимиты (0 = без ограничений)
TEXT_CHARACTER_LIMIT=0
IMAGE_COUNT_LIMIT=0
IMAGE_SIZE_LIMIT_MB=0
IMAGE_MAX_DIMENSION=2000
FILE_COUNT_LIMIT=0
FILE_SIZE_LIMIT_MB=0
UPLOAD_RATE_LIMIT_MAX=0
WRITE_RATE_LIMIT_MAX=120
WRITE_RATE_LIMIT_WINDOW_MS=60000

# Автосохранение (мс)
AUTOSAVE_DELAY_MS=800

# Директории данных (внутри контейнера)
DATA_DIRECTORY=/app/data
UPLOAD_DIRECTORY=/app/data/uploads
THUMBNAIL_DIRECTORY=/app/data/thumbnails
FILES_DIRECTORY=/app/data/files

# Ключ доступа (оставьте пустым для входа без пароля)
OPTIONAL_ACCESS_TOKEN=

# Автоматическое удаление старых данных в часах (0 = отключено)
CONTENT_EXPIRY_HOURS=0

# Уровень логов (debug, info, warn, error)
LOG_LEVEL=info
